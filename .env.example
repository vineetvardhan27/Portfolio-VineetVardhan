# ==========================================
# Email Delivery Configuration
# Choose either Resend OR Gmail/SMTP:
# ==========================================

# Option 1: Resend (Recommended, https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# If your custom domain is verified in Resend:
RESEND_FROM_EMAIL=Vineet <hello@vineetvardhan.dev>
# If domain is not yet verified in Resend, use the sandbox address:
# RESEND_FROM_EMAIL=Vineet Portfolio <onboarding@resend.dev>

# Destination email where inquiries are sent:
CONTACT_EMAIL=vineetvardhanwork@gmail.com

# Anti-Bot Security & CAPTCHA secret (Optional; defaults to RESEND_API_KEY if not specified)
# CAPTCHA_SECRET=your_custom_random_secret_salt_here

# Option 2: Gmail SMTP (Use App Password from https://myaccount.google.com/apppasswords)
# EMAIL_USER=vineetvardhanwork@gmail.com
# EMAIL_PASS=your_16_character_app_password
